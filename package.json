{
  "name": "web-collage-share-server",
  "version": "2.0.0",
  "private": true,
  "description": "Web Collage v2 읽기 전용 공유 링크 서버 (PLAN M6). 콜라주 본체는 익스텐션 로컬(IndexedDB)에 있고, 이 서버는 사용자가 '공유'를 누른 콜라주의 사본만 보관한다.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "express": "^5.2.1"
  },
  "optionalDependencies": {
    "mongodb": "^7.7.0"
  }
}
